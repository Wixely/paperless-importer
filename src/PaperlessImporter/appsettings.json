{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Importer": {
    "Locations": [
      {
        "InputPath": "data/inbox",
        "ProcessingPath": "data/processing",
        "OutputPath": "data/archive",
        "QuarantinePath": "data/quarantine",
        "SuccessDisposition": "Move"
      }
    ],
    "HealthPath": "data/health/status.txt",
    "AllowedExtensions": [ ".pdf", ".png", ".jpg", ".jpeg", ".tif", ".tiff" ],
    "StablePollsRequired": 2,
    "MinimumAgeSeconds": 30,
    "PollIntervalSeconds": 10,
    "MaximumFileBytes": 104857600,
    "LivenessStaleSeconds": 120,
    "ReadinessStaleSeconds": 180,
    "BacklogProgressStaleSeconds": 900,
    "TaskClockSkewSeconds": 300
  },
  "Paperless": {
    "BaseUrl": null,
    "Token": "",
    "TokenFile": "",
    "RequestTimeoutSeconds": 120
  }
}
