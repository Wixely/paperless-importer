{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "process",
      "command": "dotnet",
      "args": [ "build", "PaperlessImporter.slnx" ],
      "problemMatcher": "$msCompile",
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "test",
      "type": "process",
      "command": "dotnet",
      "args": [ "test", "PaperlessImporter.slnx", "--no-restore" ],
      "problemMatcher": "$msCompile",
      "group": "test"
    }
  ]
}
